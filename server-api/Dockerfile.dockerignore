# Context is the repo root; send only what server-api/Dockerfile copies.
*
!server-api/requirements.txt
!server-api/app
!worker/bake_embedding_model.py
!worker/worker/__init__.py
!worker/worker/sigma_engine.py
!worker/worker/sigma_logsource.py
!worker/worker/decoder_engine.py
!worker/worker/agent_health.py
!worker/worker/knowledge_query.py
!worker/worker/knowledge_markdown.py
!worker/worker/malware_hashes.py
!worker/worker/soar/__init__.py
!worker/worker/soar/graph.py
!worker/worker/soar/template.py
!worker/worker/soar/curl.py
!worker/worker/soar/case_outbox.py
# built-in YARA rule pack, synced into yara_rules at start (services/yara_builtin.py)
!yara/builtin
# community YARA pack (YARA-Forge, licence-filtered; agent/cmd/yarapack)
!yara/community
# yaracheck build stage: the agent module's YARA engine and the CLI, not its test fixtures
!agent/go.mod
!agent/go.sum
!agent/internal/yara
agent/internal/yara/testdata
agent/internal/yara/*_test.go
!agent/cmd/yaracheck
agent/cmd/yaracheck/*_test.go
**/__pycache__
