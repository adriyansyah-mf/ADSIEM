# Builds the agent packages the dashboard serves (Agents → Deploy agent):
# the same scripts as the release workflow — .deb, .rpm and the Windows zip.
FROM golang:1.25-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends clang llvm rpm zip \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN clang -O2 -g -target bpf -D__TARGET_ARCH_x86 \
    -I internal/procexec/bpf/include \
    -c internal/procexec/bpf/execve.bpf.c \
    -o internal/procexec/bpf/execve.bpf.o
RUN export VERSION="$(cat VERSION)" \
    && bash packaging/build-deb.sh >/dev/null \
    && ARCH=x86_64 bash packaging/build-rpm.sh >/dev/null \
    && ARCH=amd64 bash packaging/build-windows.sh
# /output is the agent_packages volume: replace the previous build's files
CMD ["sh", "-c", "rm -f /output/siem-agent* && cp dist/packages/siem-agent* /output/ && ls -l /output"]
