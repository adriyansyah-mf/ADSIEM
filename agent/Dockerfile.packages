# Builds the agent packages the dashboard serves (Agents → Deploy agent):
# the same scripts as the release workflow — .deb, .rpm and the Windows zip.
FROM golang:1.25-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends clang llvm rpm zip \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN clang -O2 -g -target bpf -D__TARGET_ARCH_x86 \
    -I internal/procexec/bpf/include \
    -c internal/procexec/bpf/execve.bpf.c \
    -o internal/procexec/bpf/execve.bpf.o \
 && clang -O2 -g -target bpf -D__TARGET_ARCH_x86 \
    -I internal \
    -c internal/netwatch/bpf/netwatch.bpf.c \
    -o internal/netwatch/bpf/netwatch.bpf.o
# Public keys built into these agents for self-update (base64 ed25519, comma
# separated). Sign with SIEM_UPDATE_SIGNING_KEY at run time (see CMD).
ARG UPDATE_KEYS=""
ENV UPDATE_KEYS=${UPDATE_KEYS}
RUN go build -o /usr/local/bin/siem-update-sign ./cmd/siem-update-sign
RUN export VERSION="$(cat VERSION)" \
    && bash packaging/build-deb.sh >/dev/null \
    && ARCH=x86_64 bash packaging/build-rpm.sh >/dev/null \
    && ARCH=amd64 bash packaging/build-windows.sh
# The MSI needs WiX on Windows, so it's built (and smoke-tested) by the release
# workflow; take the one for this version from the release when it exists.
# Without it the dashboard offers the Windows zip instead.
ARG AGENT_RELEASES=https://github.com/adriyansyah-mf/ADSIEM/releases/download
RUN VERSION="$(cat VERSION)" \
    && (curl -fsSL -o "dist/packages/siem-agent-${VERSION}-x64.msi" \
          "${AGENT_RELEASES}/agent-v${VERSION}/siem-agent-${VERSION}-x64.msi" \
        || { rm -f "dist/packages/siem-agent-${VERSION}-x64.msi"; echo "no MSI released for ${VERSION}; serving the zip"; }) \
    && (curl -fsSL -o "dist/packages/siem-agent-${VERSION}-x64.msi.sig" \
          "${AGENT_RELEASES}/agent-v${VERSION}/siem-agent-${VERSION}-x64.msi.sig" \
        || rm -f "dist/packages/siem-agent-${VERSION}-x64.msi.sig")
# /output is the agent_packages volume. With SIEM_UPDATE_SIGNING_KEY in the
# environment the locally built packages are signed for self-update (the
# released MSI keeps the release's signature); see packaging/publish-packages.sh.
CMD ["sh", "packaging/publish-packages.sh"]
