[Unit]
Description=SIEM Platform Agent
Documentation=https://github.com/siem-platform/agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Root, like other EDR agents: eBPF process/network telemetry, host isolation,
# firewall blocks, quarantine and approved AI commands all need it.
User=root
EnvironmentFile=-/etc/siem-agent/env
ExecStart=/usr/bin/siem-agent -config /etc/siem-agent/config.yaml
# Anti-tamper: killed or crashed → back in 5s. `systemctl stop` still stops it,
# and the agent reports that to the server first (alerted as "SIEM Agent Stopped").
Restart=always
RestartSec=5s
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
