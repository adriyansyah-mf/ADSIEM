<?xml version="1.0" encoding="utf-8"?>
<!--
  SIEM agent MSI (WiX v5: packaging/build-msi.ps1). Install like Wazuh's:

    msiexec /i siem-agent-<version>-x64.msi /qn SERVER_URL=https://siem.example.com ENROLLMENT_KEY=<key> [AGENT_NAME=web01] [ENABLE_AUDITING=1]

  The properties go to `siem-agent.exe -configure`, which writes
  %ProgramData%\SIEMAgent\config.yaml before the service starts. Upgrades
  (a newer MSI, properties optional) keep that config and its agent token;
  uninstall removes the service and binary but leaves %ProgramData%\SIEMAgent.
  Uninstalling needs the agent's uninstall token (dashboard → Agents):
    msiexec /x siem-agent-<version>-x64.msi /qn UNINSTALL_TOKEN=<token>
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="SIEM Agent" Manufacturer="SIEM Platform" Version="$(Version)"
           UpgradeCode="0F952687-E21C-4316-9931-D9A9C4FE7FA2" Scope="perMachine" Compressed="yes">
    <!-- Downgrades allowed: rolling back a self-update rollout installs the
         older MSI over the newer one (agent/internal/update). -->
    <MajorUpgrade AllowDowngrades="yes" />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="SERVER_URL" Secure="yes" />
    <Property Id="ENROLLMENT_KEY" Secure="yes" Hidden="yes" />
    <Property Id="AGENT_NAME" Secure="yes" />
    <Property Id="ENABLE_AUDITING" Secure="yes" />
    <Property Id="UNINSTALL_TOKEN" Secure="yes" Hidden="yes" />
    <Property Id="ARPCOMMENTS" Value="Log collection and response agent for the SIEM platform" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SIEMAgent">
        <Component Id="AgentService" Bitness="always64">
          <File Id="AgentExe" Source="$(BinDir)\siem-agent.exe" KeyPath="yes" />
          <ServiceInstall Id="AgentServiceInstall" Name="SIEMAgent" DisplayName="SIEM Agent"
                          Description="Ships Windows event logs to the SIEM and runs live-response tasks."
                          Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem"
                          Arguments="-config &quot;[CommonAppDataFolder]SIEMAgent\config.yaml&quot;">
            <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart"
                                ThirdFailureActionType="restart" RestartServiceDelayInSeconds="10"
                                ResetPeriodInDays="1" />
          </ServiceInstall>
          <ServiceControl Id="AgentServiceControl" Name="SIEMAgent" Start="install" Stop="both"
                          Remove="uninstall" Wait="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Runs as SYSTEM after the files are in place and before StartServices.
         Fails the install (rolling back) when it can't write a config — e.g.
         a first install without SERVER_URL / ENROLLMENT_KEY. -->
    <CustomAction Id="ConfigureAgent" FileRef="AgentExe" Execute="deferred" Impersonate="no"
                  Return="check" HideTarget="yes"
                  ExeCommand="-configure -config &quot;[CommonAppDataFolder]SIEMAgent\config.yaml&quot; -server &quot;[SERVER_URL]&quot; -key &quot;[ENROLLMENT_KEY]&quot; -name &quot;[AGENT_NAME]&quot; -enable-auditing &quot;[ENABLE_AUDITING]&quot;" />
    <!-- Anti-tamper: a real uninstall (not a major upgrade removing the old
         version) needs this agent's uninstall token from the dashboard:
         msiexec /x siem-agent.msi UNINSTALL_TOKEN=<token>. Without it the
         installed agent exits non-zero and the uninstall stops here. -->
    <CustomAction Id="VerifyUninstallToken" FileRef="AgentExe" Execute="immediate"
                  Return="check" HideTarget="yes"
                  ExeCommand="-verify-uninstall -config &quot;[CommonAppDataFolder]SIEMAgent\config.yaml&quot; -token &quot;[UNINSTALL_TOKEN]&quot;" />
    <InstallExecuteSequence>
      <Custom Action="VerifyUninstallToken" Before="InstallInitialize"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="ConfigureAgent" After="InstallFiles" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
    </InstallExecuteSequence>

    <Feature Id="Main" Title="SIEM Agent">
      <ComponentRef Id="AgentService" />
    </Feature>
  </Package>
</Wix>
